{
  "manifest_version": 2,
  "id": "geffnt.group-meme-nickname",
  "version": "2.2.0",
  "name": "群梗名片 (Group Meme Nickname)",
  "description": "拿麦麦自己的名字当词根，嫁接群里最近真正在聊的梗，造一个群友外号风格的群名片。读写优先走 napcat-adapter 已连接的 WebSocket（公开 API adapter.napcat.action.call），无需另开 NapCat HTTP 服务器，HTTP 仅作回退",
  "author": {
    "name": "geffnt",
    "url": "https://github.com/geffnt"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/geffnt/maibot-group-meme-nickname",
    "documentation": "https://github.com/geffnt/maibot-group-meme-nickname/blob/main/README.md"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "999.999.999"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "config.get",
    "llm.generate",
    "message.get_recent",
    "message.build_readable",
    "chat.get_stream_by_group_id",
    "chat.get_group_streams",
    "knowledge.search",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
